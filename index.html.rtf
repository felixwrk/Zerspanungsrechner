<body>\
<h1>Zerspanungsrechner</h1>\
<div class="container">\
\
  <!-- FR\'c4SEN -->\
  <div class="card fraesen">\
    <h2>Fr\'e4sen</h2>\
    <svg viewBox="0 0 200 140">\
      <rect x="20" y="100" width="160" height="25" fill="#b0bec5"/>\
      <circle id="fCircle" cx="100" cy="65" r="35" fill="none" stroke="#1565c0" stroke-width="3"/>\
      <line x1="100" y1="65" x2="135" y2="65" stroke="#1565c0" stroke-width="2"/>\
      <line x1="65" y1="65" x2="135" y2="65" stroke="#1565c0" stroke-dasharray="4"/>\
      <text x="100" y="20" text-anchor="middle" font-size="12" fill="#1565c0">Fr\'e4ser \'d8 d</text>\
      <text x="100" y="85" text-anchor="middle" font-size="11">n</text>\
    </svg>\
\
    <h3>Drehzahl aus Schnittgeschwindigkeit</h3>\
